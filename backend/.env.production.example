# ---- Backend production env (set these in your host's dashboard) ----
APP_NAME="FYP Platform"
APP_ENV=production
APP_KEY=                       # generate one: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-backend-url

# Your Vercel frontend (used for CORS + Sanctum stateful detection).
FRONTEND_URL=https://your-app.vercel.app
SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app

# Managed MySQL/MariaDB (Railway/Render/Aiven/PlanetScale).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions in the DB (stateless-friendly; no sticky sessions needed).
SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax          # 'lax' works with the Next.js proxy (same-origin).
                               # If you serve the API cross-site instead, use 'none'.

CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr             # so logs show up in the platform console
FILESYSTEM_DISK=local          # PDFs live on a mounted persistent volume (see docs)
