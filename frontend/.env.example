# --- Local development (copy to .env.local) ---
# Call the Laravel API directly (it allows this origin via CORS).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Production on Vercel (set these in the Vercel dashboard instead) ---
# Leave NEXT_PUBLIC_API_URL EMPTY and set BACKEND_URL so /api and /sanctum are
# proxied to the backend (same-origin → first-party cookies):
#   NEXT_PUBLIC_API_URL=
#   BACKEND_URL=https://your-backend-url
