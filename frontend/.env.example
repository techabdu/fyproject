# Local development (copy this file to .env.local):
# call the Laravel API directly — the backend allows this origin via CORS and
# shares the Sanctum session cookie across ports (SESSION_DOMAIN=localhost).
NEXT_PUBLIC_API_URL=http://localhost:8000

# In the Docker Compose setup this value is baked into the image at build time
# (see compose.yaml / frontend/Dockerfile), so you don't need a .env.local there.
